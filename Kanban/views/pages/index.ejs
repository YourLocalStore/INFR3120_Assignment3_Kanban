<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/bootstrap/dist/css/bootstrap.min.css' />
    <link rel="stylesheet" href="/fontawesome-free-7.3.1-web/css/all.css">
    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <link href='https://fonts.googleapis.com/css?family=Inter' rel='stylesheet'>
  </head>

  <body>
    <%- include ../partials/main_nav.ejs %>
    <div class="container-fluid text-center d-flex justify-content-center align-items-center"
          style="min-height: calc(100vh - 356px)"> <!-- At least 100 viewport height, which is subtracted by some approximate height of the header + footer. -->
      <div class="row">

        <div class="col-12">
          <h1 style="font-size:50px;"><img src="/images/kb_logo.png" style="width: 100px"> <%= title %> </h1>
          <p class="fs-5 mt-3">Create, edit and view your own kanban board!</p>   
          <a href="/boards" class="btn btn-custom blueBtn mt-3">Get Started!</a>
          <a href="/about" class="btn btn-custom greenBtn mt-3">Learn More</a>
        </div>

      </div>
    </div>
    <%- include ../partials/footer.ejs %>
  </body>
</html>
