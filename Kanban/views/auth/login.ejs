<!DOCTYPE html>
<html>
    <head>
        <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
        <link rel='stylesheet' href='/stylesheets/style.css' />
        <link rel='stylesheet' href='/bootstrap/dist/css/bootstrap.min.css' />
        <link rel="stylesheet" href="/fontawesome-free-7.3.1-web/css/fontawesome.min.css">
        <script src="/bootstrap/dist/js/bootstrap.min.js"></script>

        <link href='https://fonts.googleapis.com/css?family=Inter' rel='stylesheet'>
    </head>
    <body>
        <%- include ../partials/main_nav.ejs %>
        <main class="container-fluid mt-3 w-75 text-start">

            <div class="row mt-3 text-center">
                <h1>Login</h1>
                <p>Sign in to view your own board!</p>
            </div>

            <div class="row bg-dark rounded">
                <div class="col-12 col-md-6">
                    <div class="form-container pt-3 pb-3 text-white">
                        <form method="post" autocomplete="off">

                            <div class="form-group col-12 mb-3">
                                <!--username,password,displayName,email-->
                                <label for="username">Username</label>
                                <input type="text"
                                        name="username" 
                                        placeholder="Username"
                                        class="form-control" id="username" 
                                        required autofocus>
                            </div>

                            <div class="form-group col-12">
                                <!--username,password,displayName,email-->
                                <label for="password">Password</label>
                                <input type="password"
                                        name="password" 
                                        placeholder="Password"
                                        class="form-control" id="password" 
                                        required>
                            </div>

                            <div class="form-group col-12 mt-3 mb-3">
                                <input type="submit" class="btn btn-custom greenBtn w-100"
                                        value="Login">                             
                            </div>
                        </form>

                        <form action="/auth/google" method="GET">
                            <button type="submit" class="btn btn-custom googleBtn w-100 mb-3"> 
                                <i class="fa-brands fa-google me-3"></i>Login with Google
                            </button>
                        </form>  
                        
                    </div>
                    <p class="text-end mb-0 text-white">Don't have an account?</p>
                    <a href="/register">
                        <p class="text-end">Sign Up</p>
                    </a>                       
                </div>            
                
                <div class="col-12 col-md-6 rounded" 
                    style="background: linear-gradient(to left, black, transparent 50%), 
                            url('/images/baltzericehat.jpg') no-repeat; 
                            background-position: center; 
                            background-size: cover;">
                </div>

            </div>

        </main>
    <%- include ../partials/footer.ejs %>
    </body> 
</html>