<!DOCTYPE html>
<html>
    <head>
        <link rel='stylesheet' href='/stylesheets/style.css'>
        <link rel='stylesheet' href='/stylesheets/media.css'>
        <link rel='stylesheet' href='/bootstrap/dist/css/bootstrap.min.css'>
        <link rel="stylesheet" href="/fontawesome-free-7.3.1-web/css/fontawesome.min.css">
        <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

        <link href='https://fonts.googleapis.com/css?family=Inter' rel='stylesheet'>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    </head>
    <body>
        <%- include ../partials/main_nav.ejs %>
        <main class="container-fluid mt-3 w-100 text-start d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 356px);">
            <div class="row bg-dark rounded w-75">
                <div class="col-12 col-md-6">
                    <div class="form-container pt-3 pb-3 text-white">

                        <div class="row mt-3">
                            <div class="col-12 mt-3 mb-3">
                                <h1>Register</h1>
                                <p>Sign up to start creating!</p>
                                <hr>
                            </div>
                        </div>                

                        <form method="post" autocomplete="off">
                            
                            <% if(message.length > 0 && !authFlag) {%>
                                <div class="alert alert-danger">
                                    <%= message %>
                                </div>
                            <% } else if(message.length > 0 && authFlag) { %>
                                 <div class="alert alert-success">
                                    <%= message %>
                                </div>                               
                            <% } %>

                            <div class="form-group col-12 mb-3">
                                <!--username,password,displayName,email-->
                                <label for="username">Username</label>
                                <input type="text"
                                        name="username" 
                                        placeholder="Username"
                                        class="form-control" id="username" 
                                        required autofocus>
                            </div>

                            <div class="form-group col-12 mb-3">
                                <!--username,password,displayName,email-->
                                <label for="password">Password</label>
                                <input type="password"
                                        name="password" 
                                        placeholder="Enter the password"
                                        class="form-control" id="password" 
                                        required>
                            </div>

                            <div class="form-group col-12 mb-3">
                                <!--username,password,displayName,email-->
                                <label for="email">Email Address</label>
                                <input type="email"
                                        name="email" 
                                        placeholder="Enter your email"
                                        class="form-control" id="email" 
                                        required autofocus>
                            </div>
                            
                            <div class="form-group col-12 mb-3">
                                <!--username,password,displayName,email-->
                                <label for="displayName">Display Name</label>
                                <input type="text"
                                        name="displayName" 
                                        placeholder="Enter a display name"
                                        class="form-control" id="displayName" 
                                        required>
                            </div>                            

                            <div class="form-group col-12 mb-3">
                                <input type="submit" class="btn btn-custom blueBtn w-100"
                                        value="Register">                             
                            </div>
                        </form>

                        <hr>

                        <form action="/auth/google" method="GET">
                            <button type="submit" class="btn btn-custom googleBtn w-100 mb-3"> 
                                <i class="fa-brands fa-google me-3"></i>Register with Google
                            </button>
                        </form>  

                        <form action="/auth/github" method="GET">
                            <button type="submit" class="btn btn-custom googleBtn w-100 mb-3"> 
                                <i class="fa-brands fa-github me-3"></i>Register with Github
                            </button>
                        </form>
                        
                    </div>
                    <p class="text-end mb-0 text-white">Already have an account?</p>
                    <a href="/login">
                        <p class="text-end">Sign In</p>
                    </a>                       
                </div>            
                
                <div class="col-12 col-md-6 rounded" 
                    style="background: linear-gradient(to left, black, transparent 50%), 
                            url('/images/register.png') no-repeat; 
                            background-position: center; 
                            background-size: cover;">
                </div>

            </div>

        </main>
    <%- include ../partials/footer.ejs %>
    </body> 
</html>