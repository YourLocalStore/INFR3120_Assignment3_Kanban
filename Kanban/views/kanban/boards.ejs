<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/bootstrap/dist/css/bootstrap.min.css' />
    <link rel="stylesheet" href="/fontawesome-free-7.3.1-web/css/all.css">
    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <link href='https://fonts.googleapis.com/css?family=Inter' rel='stylesheet'>
  </head>

  <%- include ../partials/main_nav.ejs %>
  <body>
    <div class="container-fluid">

      <div class="row mt-3 mb-2">
        <div class="col-12 mx-auto mt-4">
          <h1><%= title %></h1>
          <p>View your own Kanban board!</p>          
        </div>
      </div>

      <% if (userBoard.length > 0){ %>
        
        <div class="row mt-3 mb-2 ms-0 me-0">
          <div class="col-12 pt-2 bg-dark text-white rounded">
            <h2><%= userBoard[0].boardName %></h2> <!-- There's only one board. -->
          </div>
        </div>

        <div class="row">
          <% userBoard.forEach(board => { %>

            <% board.kanbanColumn.forEach(column => { %>
              <div class="col-12 col-md-6 col-lg-4 mb-3">
                <div class="card bg-dark text-white">
                  <div class="card-title mt-3">
                    <h3 class="ms-3"> <%= column.kanbanColumnName %> 
                      <a href="/updatecolname/column/<%= column._id %>">
                        <i class="fa-solid fa-pen-to-square fa-2xs" style="color:white"></i>
                      </a> 
                    </h3>
                    <hr>                  
                  </div>
                  
                  <% column.kanbanTask.forEach(task => { %>
                    <div class="card bg-light text-dark w-75 mx-auto mb-3">
                      <div class="card-body">
                        
                        <!-- https://getbootstrap.com/docs/4.0/utilities/flex/ -->
                        <div class="dropdown d-flex align-items-center justify-content-between">
                          <h4 class="ms-3"> <%= task.kanbanTaskName %> </h4>
                          <button class="btn btn-transparent dropdown-toggle" 
                                  type="button" 
                                  data-bs-toggle="dropdown" 
                                  aria-expanded="false">
                                  <i class="fa-solid fa-bars"></i>
                          </button>
                          <ul class="dropdown-menu">
                            <li><a class="dropdown-item" 
                                    href="/updatetask/column/<%= column._id %>/task/<%= task._id %>">
                                    Edit</a>
                            </li>
                            <li><a class="dropdown-item" 
                                    href="/deletetask/column/<%= column._id %>/task/<%= task._id %>" 
                                    onclick="return confirm('Are you sure you want to delete this task?')">
                                    Delete</a>
                            </li>
                          </ul>
                        </div>
                        <p class="fs-6 ms-3"> <%= task.description %> </p>                   
                      </div>
                    </div>

                  <% }) %>

                  <div class="col-6 mb-3">
                    <a href="/addtask/column/<%= column._id %>" 
                        class="btn btn-primary mt-3 mb-3 ms-3">
                      <i class="fa-solid fa-square-plus"></i><br>
                    </a>

                    <a href="/deletecolumn/<%= column._id %>" onclick="return confirm('Are you sure you want to delete this column?')"
                        class="btn btn-danger mt-3 mb-3 ms-3">
                      <i class="fa-solid fa-trash"></i>
                    </a>

                  </div>

                </div>
              </div>
            <% }) %>
          <% }) %>

        </div>

        <a href="/addcolumn" class="btn btn-dark mt-3 mb-3 ms-2" style="width: 3rem;">
          <i class="fa-solid fa-plus"></i>
        </a>          

        <a href="/deleteboard/<%= userBoard[0]._id %>" 
            class="btn btn-danger mt-3 mb-3 ms-2" 
            style="width: 3rem;" onclick="return confirm('** WARNING ** Are you sure you want to delete your board?')">
            <i class="fa-solid fa-x"></i>
        </a>
        
        
      <% } else { %>
        <div class="row mt-3 lh-1">
            <p> No board has been made! </p>
            <p> Create one below! </p>
        </div>
        <a href="/addcolumn" class="btn btn-dark mt-3 mb-3 ms-2" style="width: 3rem;">
          <i class="fa-solid fa-plus"></i>
        </a>         
      <% } %>


    </div>
  </body>
  <%- include ../partials/footer.ejs %>
</html>
