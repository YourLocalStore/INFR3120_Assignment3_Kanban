<!DOCTYPE html>
<html>
  <head>
    <link rel='stylesheet' href='/stylesheets/style.css'>
    <link rel='stylesheet' href='/stylesheets/media.css'>
    <link rel='stylesheet' href='/bootstrap/dist/css/bootstrap.min.css'>
    <link rel="stylesheet" href="/fontawesome-free-7.3.1-web/css/fontawesome.min.css">
    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <link href='https://fonts.googleapis.com/css?family=Inter' rel='stylesheet'>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  </head>
  <body>
    <%- include ../partials/main_nav.ejs %>
    <div class="container-fluid">
      <div class="row">

        <div class="col-md-6 mt-3">
          <h1 class="mb-3"><%= title %></h1>

          <form class="form" method="post">  
            
            <% if (!boardTitleExists) { %>
              <div class="form-group">
                <label for="titleTextField"> Board Title </label>
                <input type="text" class="form-control mt-2 mb-3" id="titleTextField"
                        placeholder="Board Title"
                        name="kTitle"></div>
            <% } %>
            <div class="form-group">
              <label for="nameTextField"> Column Name </label>
              <input type="text" class="form-control mt-2" id="nameTextField"
                      placeholder="Column Name"
                      name="kColName" required></div>

            <button class="btn btn-dark mt-3" type="submit">Submit</button>
            <a href="/boards" class="btn btn-warning mt-3">Go Back!</a>            
          </form>

        </div>
      </div>
    </div>
  <%- include ../partials/footer.ejs %>
  </body>
</html>