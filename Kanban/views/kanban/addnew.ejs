<!DOCTYPE html>
<html>
  <head>
    <link rel='stylesheet' href='/stylesheets/style.css'>
    <link rel='stylesheet' href='/stylesheets/media.css'>
    <link rel='stylesheet' href='/stylesheets/index_style.css'>
    <link rel='stylesheet' href='/bootstrap/dist/css/bootstrap.min.css'>
    <link rel="stylesheet" href="/fontawesome-free-7.3.1-web/css/fontawesome.min.css">
    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <link href='https://fonts.googleapis.com/css?family=Inter' rel='stylesheet'>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  </head>
  <body>
    <%- include ../partials/main_nav.ejs %>
    <div class="container-fluid ms-5 mt-5 vh-100 text-white">
      <div class="row">
        <div class="col-md-6 mt-3">
          <form class="form" method="post">  
            
            <% if (!boardTitleExists) { %>
              <h1 class="mb-3" style="font-weight:900">Let's Get Started!</h1>
              <hr>

              <div class="form-group w-75">
                <label for="titleTextField" class="fs-3 mt-4"> Board Title </label>
                <input type="text" class="form-control mt-2" id="titleTextField"
                        aria-describedby="titleFormHelp"
                        name="kTitle">
              
                <div id="titleFormHelp" class="form-text text-white">
                  Optional, but you should name your board.
                </div>
              </div>

            <% } else { %>
              <h1 class="mb-3"> <%= title %> </h1>
              <hr>

            <% } %>

            <div class="form-group mt-3 w-75">
              <label for="nameTextField" class="fs-3 mt-2"> Column Name </label>
              <input type="text" class="form-control mt-2" id="nameTextField"
                      name="kColName" 
                      aria-describedby="colNameFormHelp"
                      required>
                <div id="colNameFormHelp" class="form-text text-white">
                  Give your column a name!
                </div>   
            </div>

            <button class="btn btn-custom redBtn mt-4" type="submit">Submit</button>
            <a href="/boards" class="btn btn-custom greenBtn mt-4">Go Back!</a>            
          </form>
        </div>

      </div>
    </div>
  <%- include ../partials/footer.ejs %>
  </body>
</html>